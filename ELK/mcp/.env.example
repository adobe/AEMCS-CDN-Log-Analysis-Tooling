# cp .env.example .env
# .env is git-ignored. Never commit real credentials.

# URL the MCP container uses to reach Elasticsearch. Use https:// for anything
# that is not on this machine.
ES_URL=https://elk.example.com:9200

# Reaching Elasticsearch through an SSH tunnel on this machine?
#   ssh -N -L 9200:localhost:9200 user@elk-server
#ES_URL=http://localhost:9200

# Authentication - pick one. Preferred: a base64 encoded API key scoped to the
# CDN log indices only, see README.md ("Elasticsearch permissions").
ES_API_KEY=

ES_USERNAME=
ES_PASSWORD=

# Disables certificate verification. Only for a development cluster with a
# self-signed certificate.
ES_SSL_SKIP_VERIFY=false

# Host port for the MCP endpoint, always bound to 127.0.0.1. Change it if 8080
# is taken, and update your AI client config to match.
MCP_PORT=8080
